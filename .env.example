# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# RAZORPAY_KEY_ID: Public API Key for Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_FinFamElite2026

# BACKEND_BASE_URL: Backend Payment Verification Service URL
BACKEND_BASE_URL=https://api.finfam.app/

